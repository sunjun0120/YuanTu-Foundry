# Documentation only: these variables must be exported into the process environment.
ANTHROPIC_API_KEY=
YUANTU_PROTOCOL=anthropic
# Use YUANTU_PROTOCOL=openai for OpenAI Chat Completions-compatible gateways.
OPENAI_API_KEY=
YUANTU_MODEL=
# Optional endpoint root for the chosen protocol (HTTPS except loopback).
YUANTU_BASE_URL=https://api.anthropic.com
# Optional credential alias, takes priority over ANTHROPIC_API_KEY.
YUANTU_API_KEY=

# Retry only explicit temporary HTTP errors before SSE; 0 disables retries.
YUANTU_MAX_RETRIES=2

# Provider-side prompt caching is on by default: Anthropic gets cache breakpoints on the
# system prompt, the last tool and the newest message; OpenAI gets prompt_cache_key.
# Set to 0 for endpoints that reject those fields.
# YUANTU_PROMPT_CACHE=0

# Optional explicit trusted approval policy, read once when CLI/Host starts
# YUANTU_PERMISSION_POLICY=C:/Users/me/yuantu-permissions.json
# YUANTU_PROTOCOL also supports openai-responses (OpenAI Responses API)

# Web tools. web_search defaults to the keyless DuckDuckGo endpoint; set a
# provider and key for stable, rate-limit-free results (brave | tavily).
YUANTU_SEARCH_PROVIDER=duckduckgo
YUANTU_SEARCH_API_KEY=
# Optional endpoint override; the provider default is used when unset.
# YUANTU_SEARCH_BASE_URL=

# Durable memory is markdown: <workspace>/.yuantu/memory.md and ~/.yuantu/memory.md.
# YUANTU_MEMORY_DIR overrides the directory holding the user-wide memory.md.
# YUANTU_KNOWLEDGE_DB overrides the SQLite file used for indexed project documents.
# YUANTU_MEMORY_DIR=C:/Users/me/.yuantu
# YUANTU_KNOWLEDGE_DB=C:/Users/me/.yuantu/knowledge.sqlite
